# =============================================================================
# Interview Prep App — env vars
# Copy to .env.local and fill in. Set the same vars in Vercel for production.
# =============================================================================

# --- NextAuth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Local: http://localhost:3000 · Production: https://your-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000
# NextAuth v5 also reads AUTH_SECRET. Keep both in sync to be safe.
AUTH_SECRET=

# --- Google OAuth -------------------------------------------------------------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth -------------------------------------------------------------
# github.com/settings/developers → New OAuth App
# Authorisation callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# --- Supabase -----------------------------------------------------------------
# app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Used by NextAuth adapter + seed.
SUPABASE_SERVICE_ROLE_KEY=
